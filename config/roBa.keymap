#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27
#define KEYS_R 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33
#define THUMBS 34 35 36 37 38 39 40 41
#define DEFAULT 0
#define GAME 1
#define NUM_NAV 2
#define FUN 3
#define MOUSE 4
#define SCROLL 5
#define COMBO_TERM 30
#define TAPPING_TERM 280
#define QUICK_TAP_TERM 175
#define REQUIRE_PRIOR_IDLE 175

&mt {
    tapping-term-ms = <TAPPING_TERM>;
    flavor = "tap-preferred";
    quick-tap-ms = <QUICK_TAP_TERM>;
    require-prior-idle-ms = <REQUIRE_PRIOR_IDLE>;
};

&lt {
    tapping-term-ms = <TAPPING_TERM>;
    flavor = "tap-preferred";
    quick-tap-ms = <QUICK_TAP_TERM>;
};

/ {
    behaviors {
        hrml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP_TERM>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS 5 6 7 8 9 17 18 19 20 21 29 30 31 32 33 40 41>;
            hold-trigger-on-release;
        };

        hrmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP_TERM>;
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS 26 14 4 3 2 1 0 12 11 10 13 25 24 23 22 37 38 39>;
            hold-trigger-on-release;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        smart_shft: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;

            mods = <(MOD_LSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;

            mods = <(MOD_LSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;

            mods = <(MOD_LSFT)>;
        };

        qmrk_excl: qmrk_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QMARK>, <&kp EXCL>;

            mods = <(MOD_LSFT)>;
        };

        slh_morph: slh_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BSLH>;

            mods = <(MOD_LSFT)>;
        };

        amps_morph: amps_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp AMPS>, <&kp PIPE>;

            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 10>;
            layers = <DEFAULT>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <11 1>;
            layers = <DEFAULT>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <12 2>;
            layers = <DEFAULT>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <13 3>;
            layers = <DEFAULT>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <10 22>;
            layers = <DEFAULT>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <11 23>;
            layers = <DEFAULT>;
        };

        ampersand {
            bindings = <&amps_morph>;
            key-positions = <24 12>;
            layers = <DEFAULT>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <13 25>;
            layers = <DEFAULT>;
        };

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <14 4>;
            layers = <DEFAULT>;
        };

        lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <26 14>;
            layers = <DEFAULT>;
        };

        rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <17 5>;
            layers = <DEFAULT>;
        };

        rparen {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <29 17>;
            layers = <DEFAULT>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <21 33>;
            layers = <DEFAULT>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <30 18>;
            layers = <DEFAULT>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <32 20>;
            layers = <DEFAULT>;
        };

        slash_morph {
            bindings = <&slh_morph>;
            key-positions = <8 20>;
            layers = <DEFAULT>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <18 6>;
            layers = <DEFAULT>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <19 7>;
            layers = <DEFAULT>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <31 19>;
            layers = <DEFAULT>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <9 21>;
            layers = <DEFAULT>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <23 24>;
            layers = <DEFAULT>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <31 30>;
            layers = <DEFAULT>;
        };

        backspace {
            bindings = <&bspc_del>;
            key-positions = <32 31>;
            layers = <DEFAULT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W         &kp F         &kp P          &kp B                                                &kp J        &kp L          &kp U         &kp Y         &kp APOS
&hrml LCTRL A  &hrml LALT R  &hrml LGUI S  &hrml LSHFT T  &kp G             &none                 &none        &kp M        &hrmr LSHFT N  &hrmr LGUI E  &hrmr LALT I  &hrmr LCTRL O
&kp Z          &kp X         &kp C         &kp D          &kp V             &none                 &none        &kp K        &kp H          &comma_semi   &dot_colon    &qmrk_excl
&none          &none         &none         &lt 3 ESCAPE   &lt SCROLL SPACE  &kp LEFT_COMMAND      &smart_shft  &mo NUM_NAV                                             &to 1
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        game_layer {
            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E    &kp R                             &trans  &kp F9  &kp F10  &kp F11  &kp F12
&kp LEFT_SHIFT    &kp A  &kp S  &kp D    &kp F      &none          &none   &trans  &kp F5  &kp F6   &kp F7   &kp F8
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C    &kp V      &none          &none   &trans  &kp F1  &kp F2   &kp F3   &kp F4
&none             &none  &none  &kp TAB  &kp SPACE  &kp ENTER      &trans  &trans                            &to DEFAULT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        num_nav_layer {
            bindings = <
&kp PG_UP      &kp HOME  &kp UP_ARROW  &kp END    &none                       &none   &kp N7        &kp N8        &kp N9        &none
&kp PAGE_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT  &none   &none       &none   &none   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0
&kp ESCAPE     &kp TAB   &kp ENTER     &bspc_del  &none   &none       &none   &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none
&none          &none     &none         &trans     &trans  &trans      &trans  &trans                                            &none
            >;
        };

        fun_layer {
            bindings = <
&kp PRINTSCREEN  &kp K_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &out OUT_USB                      &to GAME     &kp F9  &kp F10  &kp F11  &kp F12
&bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none       &none   &to DEFAULT  &kp F5  &kp F6   &kp F7   &kp F8
&bt BT_CLR       &kp C_PREV    &kp C_PP      &kp C_NEXT    &out OUT_BLE  &none       &none   &none        &kp F1  &kp F2   &kp F3   &kp F4
&none            &none         &none         &none         &trans        &trans      &trans  &trans                                 &none
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &none     &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none      &none     &none      &none
&none  &none  &none  &none  &none  &none      &none  &none  &mkp LCLK  &mkp MB3  &mkp RCLK  &none
&none  &none  &none  &none  &none  &none      &none  &none  &mkp MB4   &none     &mkp MB5   &none
&none  &none  &none  &none  &none  &none      &none  &none                                  &none
            >;
        };
    };
};
